# CloudMeet Frontend Environment Variables

# Backend API (FastAPI)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Supabase Authentication (Part 2)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WebRTC STUN/TURN Configuration (Part 5)
# If left empty, default public STUN (stun:stun.l.google.com:19302) is used
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
