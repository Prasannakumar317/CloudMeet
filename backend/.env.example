# CloudMeet Backend Environment Variables

# MongoDB Atlas cluster0 connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=cloudmeet

# Supabase Auth Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173
